# Cap Collective Dashboard - Environment Variables
# Copy this file to .env.local and fill in your values

# Google Sheets Configuration
# Get your Sheet ID from the URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
# The Sheet must be published to web (File > Share > Publish to web > Entire document > CSV)
NEXT_PUBLIC_SHEETS_ID=your_google_sheet_id_here

# Tab GIDs (from the sheet URL: .../edit#gid=XXXX). Defaults to 0.
NEXT_PUBLIC_GID_IMPACT=0
NEXT_PUBLIC_GID_COLLECTION=0
NEXT_PUBLIC_GID_PRODUCTS=0
NEXT_PUBLIC_GID_ROLES=0
NEXT_PUBLIC_GID_SENSORS=0

# Optional: Google Sheets API (for better performance/rate limits)
# Enable Google Sheets API in Google Cloud Console and create API key
# GOOGLE_SHEETS_API_KEY=your_api_key_here

# Optional: Custom domain for the dashboard
# NEXT_PUBLIC_SITE_URL=https://capcollective.vercel.app

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn_here