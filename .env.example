# CapBot — server-side secrets only. NEVER commit your real key.
# Copy this file to `.env` (local) or add these in the Vercel dashboard (production).

GEMINI_API_KEY=your-gemini-api-key

# Optional — model to use (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional — restrict the endpoint to your site's origin (recommended for production)
# CAPBOT_ALLOW_ORIGIN=https://imredavid64-glitch.github.io
