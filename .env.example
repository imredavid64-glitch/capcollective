# Server-side secrets only. NEVER commit your real keys.
# Copy this file to `.env` (local) or add these in the Vercel dashboard (Production / Preview / Development).
#
# Keys stay on the server; the browser never sees them.

# ---- CapBot (api/chat.js) ----
GEMINI_API_KEY=your-gemini-api-key
# Optional — model to use (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
# Optional — restrict the endpoint to your site's origin (recommended for production)
# CAPBOT_ALLOW_ORIGIN=https://capcollective.vercel.app

# ---- Tracker (api/tracker.js) ----
# Optional — attach a Vercel KV store for persistent cross-deploy data.
# When unset, the API uses an in-memory demo dataset that resets on redeploy.
# KV_REST_API_URL=https://your-kv-project.vercel.app
# KV_REST_API_TOKEN=your-kv-access-token

# ---- Eco-Store checkout (api/checkout.js) ----
# Optional — Stripe Secret Key enables online payments. Until set, checkout falls back
# to the "order for pickup" email flow.
# STRIPE_SECRET_KEY=sk_live_...

# ---- Contact / newsletter (api/contact.js) ----
# Optional — Resend API key enables the contact form email. Until set, the form falls back
# to instructing visitors to email directly.
RESEND_API_KEY=your-resend-api-key
# Optional — who receives contact-form messages (default: hello@capcollective.org)
CONTACT_TO=hello@capcollective.org