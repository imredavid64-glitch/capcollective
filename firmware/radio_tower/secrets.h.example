// ─────────────────────────────────────────────────────────────
//  RADIO TOWER — LOCAL SECRETS TEMPLATE
//
//  1. Copy this file to `secrets.h` in the same folder:
//         cp secrets.h.example secrets.h
//  2. Fill in your real values.
//  3. `secrets.h` is gitignored — never commit it.
//
//  Do NOT put real credentials in radio_tower.ino or in this
//  template file. Both are tracked by git.
// ─────────────────────────────────────────────────────────────
#pragma once

// Your WiFi network. NOTE: ESP-NOW requires the tower and both
// counters to be on the same channel. Prefer a dedicated 2.4 GHz
// AP for the kit rather than a shared school network.
#define SECRET_WIFI_SSID "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASS "YOUR_WIFI_PASSWORD"

// Supabase project (Project Settings → API).
// The anon key is safe to ship on devices ONLY if Row Level
// Security is enabled and the insert policy is restricted to
// the cap_counts table. See docs/technical/supabase.md.
#define SECRET_SB_URL  "https://YOUR_PROJECT.supabase.co"
#define SECRET_SB_ANON "YOUR_ANON_KEY"
