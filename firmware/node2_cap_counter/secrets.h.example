// ─────────────────────────────────────────────────────────────
//  NODE 2 (CAP COUNTER) — LOCAL SECRETS TEMPLATE
//
//  1. Copy to `secrets.h` in the same folder:
//         cp secrets.h.example secrets.h
//  2. Fill in your real values.
//  3. `secrets.h` is gitignored — never commit it.
//
//  Node 2 talks ESP-NOW only, so it normally needs no WiFi
//  credentials. RADIO_CHANNEL must match the tower's channel.
// ─────────────────────────────────────────────────────────────
#pragma once

// ESP-NOW channel — MUST match the Radio Tower's channel.
#define SECRET_RADIO_CHANNEL 1

// Optional: only needed if you enable a WiFi fallback later.
// #define SECRET_WIFI_SSID "YOUR_WIFI_SSID"
// #define SECRET_WIFI_PASS "YOUR_WIFI_PASSWORD"
